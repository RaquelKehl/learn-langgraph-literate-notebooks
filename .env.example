# Copy this file to .env to change the model mode. .env is never committed.
# fake      scripted responses, the default; used by all tests and CI
# ollama    a real local model via Ollama (run: ollama pull qwen3:8b)
# disabled  graph logic without any model
LLM_MODE=fake

# Only for LLM_MODE=ollama:
# OLLAMA_MODEL=qwen3:8b
# true lets qwen3 "think" before answering: much slower (about 60 s instead
# of 5 s per answer in NB 01) and no better for answering from documents.
# OLLAMA_REASONING=false
